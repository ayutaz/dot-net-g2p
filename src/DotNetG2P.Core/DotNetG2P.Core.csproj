<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>DotNetG2P</PackageId>
    <AssemblyName>DotNetG2P</AssemblyName>
    <RootNamespace>DotNetG2P</RootNamespace>
    <Description>Japanese Grapheme-to-Phoneme (G2P) library for .NET and Unity. OpenJTalk-compatible rule-based G2P pipeline with NJD processing, phoneme conversion, and HTS full-context label generation.</Description>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageLicenseFile />
  </PropertyGroup>

</Project>
