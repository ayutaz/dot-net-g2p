<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>DotNetG2P.NMeCab</PackageId>
    <AssemblyName>DotNetG2P.NMeCab</AssemblyName>
    <RootNamespace>DotNetG2P.NMeCab</RootNamespace>
    <Description>NMeCab tokenizer adapter for DotNetG2P. Provides ITokenizer implementation using LibNMeCab for Japanese morphological analysis with naist-jdic dictionary.</Description>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageLicenseExpression>LGPL-2.1-or-later</PackageLicenseExpression>
    <PackageLicenseFile />
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DotNetG2P.Core\DotNetG2P.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LibNMeCab" Version="0.10.2" />
  </ItemGroup>
</Project>
