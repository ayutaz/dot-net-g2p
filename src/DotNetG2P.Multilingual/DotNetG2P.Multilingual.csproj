<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>DotNetG2P.Multilingual</PackageId>
    <AssemblyName>DotNetG2P.Multilingual</AssemblyName>
    <RootNamespace>DotNetG2P.Multilingual</RootNamespace>
    <Description>Multilingual G2P engine combining Japanese, English, Chinese, Spanish, French, and Portuguese grapheme-to-phoneme support with automatic language detection.</Description>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageTags>g2p;multilingual;japanese;english;chinese;spanish;french;portuguese;ipa;pinyin;mandarin;tts;phoneme;text-to-speech;unity</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DotNetG2P.Core\DotNetG2P.Core.csproj" />
    <ProjectReference Include="..\DotNetG2P.MeCab\DotNetG2P.MeCab.csproj" />
    <ProjectReference Include="..\DotNetG2P.English\DotNetG2P.English.csproj" />
    <ProjectReference Include="..\DotNetG2P.Chinese\DotNetG2P.Chinese.csproj" />
    <ProjectReference Include="..\DotNetG2P.Spanish\DotNetG2P.Spanish.csproj" />
    <ProjectReference Include="..\DotNetG2P.French\DotNetG2P.French.csproj" />
    <ProjectReference Include="..\DotNetG2P.Portuguese\DotNetG2P.Portuguese.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DotNetG2P.Tests" />
  </ItemGroup>
</Project>
