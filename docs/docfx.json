{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            ".build/bin/DotNetG2P.Core/Release/netstandard2.1/DotNetG2P.dll",
            ".build/bin/DotNetG2P.MeCab/Release/netstandard2.1/DotNetG2P.MeCab.dll",
            ".build/bin/DotNetG2P.English/Release/netstandard2.1/DotNetG2P.English.dll",
            ".build/bin/DotNetG2P.Chinese/Release/netstandard2.1/DotNetG2P.Chinese.dll",
            ".build/bin/DotNetG2P.Korean/Release/netstandard2.1/DotNetG2P.Korean.dll",
            ".build/bin/DotNetG2P.Spanish/Release/netstandard2.1/DotNetG2P.Spanish.dll",
            ".build/bin/DotNetG2P.French/Release/netstandard2.1/DotNetG2P.French.dll",
            ".build/bin/DotNetG2P.Portuguese/Release/netstandard2.1/DotNetG2P.Portuguese.dll",
            ".build/bin/DotNetG2P.Swedish/Release/netstandard2.1/DotNetG2P.Swedish.dll",
            ".build/bin/DotNetG2P.Multilingual/Release/netstandard2.1/DotNetG2P.Multilingual.dll"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "guides/**/*.{md,yml}",
          "api/**/*.{md,yml}"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "DotNetG2P",
      "_appTitle": "DotNetG2P Documentation",
      "_enableSearch": true
    }
  }
}
